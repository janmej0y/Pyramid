# Copy to .env and adjust. SQLite needs no external service.
DATABASE_URL="file:./dev.db"

# Sign secret for guest session tokens. Use a long random value in production.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"

PORT=4000

# Comma-separated list of allowed browser origins. 3001 is included because
# Next.js falls back to it when 3000 is already in use.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
