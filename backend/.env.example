# MongoDB connection string.
#
# Atlas (recommended — free M0 tier, required for any cloud deployment):
#   1. Create a free cluster at https://www.mongodb.com/cloud/atlas
#   2. Database Access -> add a user; Network Access -> allow your IP
#   3. Connect -> Drivers -> copy the string and put the database name
#      before the "?" as shown below
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pyramid?retryWrites=true&w=majority"

# Local MongoDB instead:
# DATABASE_URL="mongodb://localhost:27017/pyramid"

# Signing secret for guest session tokens. Must be at least 16 characters —
# startup validation rejects anything shorter. Replace this with a long random
# value in production.
JWT_SECRET="local-dev-secret-change-me"
JWT_EXPIRES_IN="7d"

PORT=4000

# Comma-separated list of allowed browser origins. 3001 is included because
# Next.js falls back to it when 3000 is already in use.
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# --- Google sign-in (optional) ---------------------------------------------
# Leave all four unset to run guest-only; the UI hides the Google button and
# the endpoints return 503. Setting only some of them fails at boot on purpose.
#
# From https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID
# (type: Web application).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must match an "Authorised redirect URI" in the Google console byte for byte.
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Where the API sends the browser after sign-in. Defaults to the first
# CORS_ORIGIN + /auth/callback, so it is usually fine to leave unset.
# OAUTH_SUCCESS_REDIRECT=http://localhost:3000/auth/callback
