// Pyramid task management — data model.
// SQLite keeps the assessment runnable with zero external services; the schema
// is provider-agnostic, so swapping `provider` to postgresql needs no changes.

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
  // NestJS compiles to CommonJS; without this the generated client emits ESM
  // and fails to load under ts-node / the built dist output.
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String
  title     String?
  username  String?
  avatar    String?
  /// Guests are created on demand by the guest-login flow.
  isGuest   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects Project[] @relation("ProjectLead")
  assignments   TaskAssignee[]
  reportedTasks Task[]         @relation("TaskReporter")
  comments      Comment[]
  activity      Activity[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  priority  String   @default("none")
  dueDate   DateTime?
  leadId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead  User?  @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  tasks Task[]

  @@index([leadId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  /// Board column / list group: "To Do", "Doing", "Completed", "On Hold".
  status      String    @default("To Do")
  priority    String    @default("none")
  dueDate     DateTime?
  /// Manual ordering within a status column.
  position    Int       @default(0)
  projectId   String?
  reporterId  String?
  /// Self-relation powering the subtask table on the detail screen.
  parentId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter User?    @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  parent   Task?    @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)

  subtasks  Task[]         @relation("Subtasks")
  assignees TaskAssignee[]
  labels    TaskLabel[]
  comments  Comment[]
  activity  Activity[]

  @@index([projectId])
  @@index([parentId])
  @@index([status])
}

/// Explicit join table so assignment order is stable in the members column.
model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Label {
  id    String @id @default(cuid())
  name  String @unique
  tasks TaskLabel[]
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  taskId    String
  authorId  String
  /// Set for replies inside a thread.
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task    Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
}

/// Feeds the "Updates" panel on the task detail screen.
model Activity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  /// e.g. "priority_changed", "update_posted".
  kind      String
  field     String?
  fromValue String?
  toValue   String?
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}
